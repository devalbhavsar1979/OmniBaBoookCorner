REACT_APP_API_BASE_URL=http://localhost:8000/api/v1
REACT_APP_UPLOADS_URL=http://localhost:8000/uploads
# Public-facing HTTPS domain for share links — must proxy /api/v1 and /uploads to backend
REACT_APP_SHARE_BASE_URL=https://www.boookcorner.in
# Google Maps Embed API key (enable Maps Embed API in Google Cloud Console)
REACT_APP_GOOGLE_MAPS_KEY=YOUR_GOOGLE_MAPS_EMBED_API_KEY

